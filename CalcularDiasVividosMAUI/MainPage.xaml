<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CalcularDiasVividosMAUI.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="20,0"
            Spacing="20">

            <Label x:Name="lblnome" Text="Nome:" FontSize="Subtitle" HorizontalOptions="Start" />

            <Entry x:Name="entnome" Placeholder="Nome" ClearButtonVisibility="WhileEditing" />

            <Label x:Name="lblidade" Text="Idade Atual:" FontSize="Subtitle" HorizontalOptions="Start"/>

            <Entry x:Name="entidade" Placeholder="Idade" Keyboard="Numeric"/>

            <Button x:Name="btncalcular" Text="Calcular Dias Vividos" BackgroundColor="DarkGrey" Clicked="btncalcular_Clicked" />

            <Button x:Name="btnlimpar" Text="Limpar Campos" BackgroundColor="DarkGrey" Clicked="btnlimpar_Clicked" />

            <Label x:Name="dificil" Text="Idade Atual:" FontSize="Subtitle" HorizontalOptions="Start"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
